# Safe local defaults. Production activation is recorded separately in
# .env.production and still requires the approval constants in lib/site-release.ts.
# hidden (default), preview (local review), published (requires policy approval).
NEXT_PUBLIC_WEBSITE_PRIVACY_MODE=hidden
# disabled (default), preview (NEVER loads Google), live (requires both approvals
# and a published policy). Local/preview hosts never transmit, even in live mode.
NEXT_PUBLIC_SITE_ANALYTICS_MODE=disabled
